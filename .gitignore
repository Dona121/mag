.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# uv: se versiona uv.lock, no la caché.
.uv/

# ───────────────────────────── Editores e IDE ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ───────────────────────────── Sistema operativo ─────────────────────────────
