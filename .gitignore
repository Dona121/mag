# ───────────────────────────── Secretos y entorno ─────────────────────────────
# NUNCA versionar: contienen SECRET_KEY y credenciales de la BD (Supabase).
.env
*.env
!.env.example
mag/.env

# ───────────────────────────── Python ─────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ───────────────────────────── Entornos virtuales ─────────────────────────────
.venv/
venv/
env/
ENV/

# ───────────────────────────── Django ─────────────────────────────
# Base de datos local de desarrollo.
*.sqlite3
db.sqlite3
mag/db.sqlite3

# Archivos recolectados por collectstatic (se regeneran en cada despliegue).
staticfiles/
mag/staticfiles/

# Media subida por usuarios.
media/
mag/media/

# Logs y migraciones temporales / locales.
*.log
local_settings.py

