Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ───────────────────────────── Archivos temporales del proyecto ─────────────────────────────
_test.txt
mag/_test.txt
*.tmp

# ───────────────────────────── Material de trabajo (no versionar) ─────────────────────────────
